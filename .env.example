# ══════════════════════════════════════════════════════════════
# .env.example — Sports Betting AI System
# Copia este ficheiro para .env e preenche os valores
# NUNCA commitar o ficheiro .env
# ══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# APIs de dados desportivos
# ─────────────────────────────────────────

# football-data.org — registo gratuito em https://www.football-data.org/
FOOTBALL_DATA_API_KEY=

# api-tennis.com — registo gratuito em https://api-tennis.com/
TENNIS_API_KEY=

# the-odds-api.com — registo gratuito em https://the-odds-api.com/
ODDS_API_KEY=

# ─────────────────────────────────────────
# LLM Provider — escolher UM
# ─────────────────────────────────────────

# Provider activo: anthropic | openrouter | ollama
LLM_PROVIDER=ollama

# Modelo a usar (depende do provider)
# anthropic:   claude-sonnet-4-5
# openrouter:  anthropic/claude-sonnet-4-5  ou  google/gemini-2.5-pro
# ollama:      llama3.1:8b  ou  mistral:7b
LLM_MODEL=llama3.1:8b

# Resumo curto via LLM após análise (1/true/yes ou 0/false/no). A análise matemática é sempre local;
# desligar evita chamadas ao modelo quando o resumo não é necessário.
LLM_ANALYSIS_SUMMARY=1

# Futebol: odd mínima para 1X2 ser tratada como underdog longo (só recomendada com Poisson/XGB)
FOOTBALL_LONGSHOT_MIN_ODD=6.0

# Modelo de fallback (opcional, só OpenRouter suporta)
LLM_FALLBACK_MODEL=

# Anthropic — preencher se LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# OpenRouter — preencher se LLM_PROVIDER=openrouter
# Registo em https://openrouter.ai/
OPENROUTER_API_KEY=

# Ollama — preencher se LLM_PROVIDER=ollama
# Instalar em https://ollama.ai/ e correr: ollama pull llama3.1:8b
# Em Docker, usar host.docker.internal para aceder ao Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sportsbetting
POSTGRES_USER=sba_user
POSTGRES_PASSWORD=sportsbetting                     # definir password segura

# ─────────────────────────────────────────
# RabbitMQ
# ─────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=sba_rabbit
RABBITMQ_PASSWORD=                     # definir password segura
# Management UI: http://localhost:15672

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────
# Comunicação interna entre serviços
# ─────────────────────────────────────────
# Chave partilhada entre C# API e Python Engine
INTERNAL_API_KEY=                      # gerar com: openssl rand -hex 32

# ─────────────────────────────────────────
# Alertas (opcionais)
# ─────────────────────────────────────────

# Telegram Bot — criar em https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_CONFIDENCE=7          # 1-10: só envia alerta se confiança >= este valor

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─────────────────────────────────────────
# OpenCode / GitHub MCP
# ─────────────────────────────────────────
GITHUB_TOKEN=                          # Personal Access Token com repo scope
PROJECT_ROOT=.                         # caminho raiz do projecto para MCP filesystem

# ─────────────────────────────────────────
# Aplicação
# ─────────────────────────────────────────
ENVIRONMENT=development                # development | staging | production
LOG_LEVEL=debug                        # debug | info | warning | error
